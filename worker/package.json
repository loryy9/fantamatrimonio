{
  "name": "fantamatrimonio-worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Fanta Matrimonio API + frontend su Cloudflare Workers (database Neon, foto su R2)",
  "scripts": {
    "dev": "wrangler dev",
    "build:frontend": "npm --prefix ../frontend install && npm --prefix ../frontend run build",
    "deploy": "npm run build:frontend && wrangler deploy",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "bcryptjs": "^3.0.3",
    "hono": "^4.13.17",
    "jose": "^6.2.16",
    "worker-mailer": "^1.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261109.1",
    "typescript": "^7.0.2",
    "wrangler": "^4.159.0"
  }
}
