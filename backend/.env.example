# Copia in .env e compila con i tuoi valori reali.
# Non committare .env nel repository!

# Stringa di connessione PostgreSQL da Supabase
# Project Settings → Database → Connection string → URI
DATABASE_URL=postgresql://postgres:[TUA_PASSWORD]@db.[TUO_PROGETTO].supabase.co:5432/postgres

# URL del tuo progetto Supabase
SUPABASE_URL=https://[TUO_PROGETTO].supabase.co

# Service Role Key (NON la anon key!) — Project Settings → API
SUPABASE_SERVICE_KEY=eyJ...

# Nome del bucket Supabase Storage (deve essere pubblico)
STORAGE_BUCKET=wedding-photos

# Porta su cui gira uvicorn (Railway la imposta da sola)
PORT=8000

# ── Auth & JWT ───────────────────────────────────────────────
# Segreto per firmare i token JWT. In produzione usa una stringa lunga e casuale!
JWT_SECRET=cambiami-in-produzione-per-favore

# Durata dei token JWT in ore (default: 720 = 30 giorni)
JWT_EXPIRE_HOURS=720

# ── Registration Reminder ────────────────────────────────────
# Giorni dopo la festa prima di mandare l'email di reminder per registrare l'account
REGISTRATION_REMINDER_DAYS=7

# ── Email & SMTP (opzionale per invio effettivo email) ────────
# Se omessi, le email verranno simulate nei log di console.
#
# Opzione 1: Gmail (comodissimo per iniziare)
# Crea una "Password per le app" da: Google Account -> Sicurezza -> Verifica in 2 passaggi -> Password per le app
# GMAIL_ADDRESS=latuaemail@gmail.com
# GMAIL_APP_PASSWORD=abcd efgh ijkl mnop
#
# Opzione 2: Server SMTP generico (Resend, Brevo, SendGrid, custom)
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_USER=resend
# SMTP_PASSWORD=re_123456789
# SMTP_FROM=Fanta Matrimonio <ricordi@tuodominio.com>

# URL base del frontend per i link nelle email
FRONTEND_URL=https://tuodominio.it
