# =========================================================
# CONFIGURAZIONE TEMPISTICHE EVENTO (Fanta Matrimonio)
# =========================================================

# 1. Abilitare inizio e fine giochi (true / false)
VITE_ENABLE_TIMER=true

# 2. Orario di inizio giochi (formato 'HH:mm' oppure ISO 'YYYY-MM-DDTHH:mm:ss')
VITE_START_TIME=12:00

# 3. Orario di fine giochi (formato 'HH:mm' oppure ISO 'YYYY-MM-DDTHH:mm:ss')
VITE_END_TIME=18:00

# 4. Nomi degli sposi
VITE_SPOUSE_1=Nome1
VITE_SPOUSE_2=Nome2

